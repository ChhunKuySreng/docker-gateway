ARG TOMCAT_IMAGE=tomcat:9.0.16-jre11
FROM ${TOMCAT_IMAGE}

# Save default manager webapps template
RUN cp -r /usr/local/tomcat/webapps.dist /usr/local/tomcat/webapps.template 2>/dev/null || \
    cp -r /usr/local/tomcat/webapps /usr/local/tomcat/webapps.template

# Install MySQL Connector/J driver for all web applications
RUN curl -fsSL -o /usr/local/tomcat/lib/mysql-connector-j-8.4.0.jar \
    https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/8.4.0/mysql-connector-j-8.4.0.jar


# Copy startup entrypoint script
COPY entrypoint-tomcat.sh /entrypoint-tomcat.sh
RUN chmod +x /entrypoint-tomcat.sh

EXPOSE 8080
ENTRYPOINT ["/entrypoint-tomcat.sh"]
